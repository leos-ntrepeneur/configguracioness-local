/* style.qss — tema oscuro moderno para Inventario POS.
 *
 * QSS (Qt Style Sheets) es el equivalente de Qt a CSS: selecciona widgets
 * por tipo (QPushButton { ... }), por nombre de objeto (#botonPrimario),
 * por "propiedad" (QLabel[clase="titulo"], una propiedad Qt inventada
 * nuestra, no de CSS), o por "pseudo-estado" (:hover, :pressed, :focus,
 * :disabled). Se carga una sola vez en TemaOscuro.cpp con
 * qApp->setStyleSheet(...) y Qt la aplica en cascada a TODA la aplicacion
 * (ventanas, dialogos, QMessageBox incluidos).
 *
 * Paleta (QSS no soporta variables como CSS moderno, cada color se repite
 * donde se usa; se documentan aqui para no tener que adivinar):
 *   Fondo principal     #1e1f22
 *   Superficie/panel    #2b2d31
 *   Superficie alterna  #313338  (filas alternas, hover)
 *   Borde               #3f4147
 *   Texto principal     #e3e5e8
 *   Texto secundario    #949ba4
 *   Acento (UN SOLO color, teal, para todo -- botones, foco, pestaña
 *   activa, seleccion en tablas):
 *     teal-300 (claro)   #5eead4
 *     teal-400           #2dd4bf
 *     teal-500 (base)    #14b8a6
 *     teal-600           #0d9488
 *     teal-700           #0f766e
 *     teal-800 (oscuro)  #115e59
 *   Peligro             #ed4245 / hover #c62a2d
 *
 * Fuentes: "Manrope" (incrustada, ver TemaOscuro.cpp) solo para titulos y
 * encabezados -- el texto de datos (tablas, formularios, botones) se queda
 * con la fuente del sistema (Segoe UI en Windows), que a tamaños chicos es
 * mas legible que casi cualquier fuente "de diseño".
 */

/* ---------- Base ---------- */
QWidget {
    background-color: #1e1f22;
    color: #e3e5e8;
    font-size: 15px;
}

QMainWindow, QDialog {
    background-color: #1e1f22;
}

QLabel {
    background: transparent;
}

/* Texto secundario (subtitulos, ayudas) -- se asigna con
 * etiqueta->setProperty("clase", "secundario") desde C++. */
QLabel[clase="secundario"] {
    color: #949ba4;
}

/* Titulo de seccion dentro de una pestaña (ej. "Carrito",
 * "Productos disponibles"). Manrope ExtraBold: mas caracter que la fuente
 * del sistema, pero SOLO aqui -- el resto de la app sigue en la fuente por
 * defecto para mantener la legibilidad de datos. */
QLabel[clase="titulo"] {
    color: #e3e5e8;
    font-family: "Manrope";
    font-size: 20px;
    font-weight: 800;
}

/* ---------- Pestañas (QTabWidget) ---------- */
QTabWidget::pane {
    border: 1px solid #3f4147;
    border-radius: 6px;
    top: -1px;
    background-color: #2b2d31;
}

QTabBar::tab {
    background-color: transparent;
    color: #949ba4;
    font-family: "Manrope";
    padding: 10px 20px;
    margin-right: 2px;
    border: none;
    border-bottom: 2px solid transparent;
    font-weight: 700;
    font-size: 15px;
}

QTabBar::tab:hover {
    color: #e3e5e8;
}

QTabBar::tab:selected {
    color: #e3e5e8;
    border-bottom: 2px solid #14b8a6;
}

/* ---------- Botones ---------- */
QPushButton {
    background-color: #313338;
    color: #e3e5e8;
    border: 1px solid #3f4147;
    border-radius: 6px;
    padding: 9px 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #3a3c42;
    border-color: #4a4d54;
}

QPushButton:pressed {
    background-color: #26272b;
}

QPushButton:disabled {
    color: #5c5f66;
    background-color: #26272b;
    border-color: #313338;
}

/* Botones de accion principal (marcados desde C++ con setProperty("clase",
 * "primario"), o el boton "por defecto" de un QDialogButtonBox -- el que
 * dispara Enter, normalmente "Aceptar"). qlineargradient pinta un degradado
 * diagonal en teal (el mismo color de la seleccion en tablas -- un solo
 * acento consistente en toda la app) en vez de un color plano: dos tonos
 * de la MISMA familia (no un arcoiris), lo suficientemente sutil para no
 * estorbar la lectura del texto del boton encima. */
QPushButton:default,
QPushButton[clase="primario"] {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2dd4bf,
        stop: 1 #0d9488
    );
    border-color: #0d9488;
    color: #052e2b;
    font-weight: 700;
}

QPushButton:default:hover,
QPushButton[clase="primario"]:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #5eead4,
        stop: 1 #0f9488
    );
}

QPushButton:default:pressed,
QPushButton[clase="primario"]:pressed {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #0f9488,
        stop: 1 #115e59
    );
}

QPushButton[clase="peligro"] {
    background-color: transparent;
    border-color: #ed4245;
    color: #ed4245;
}

QPushButton[clase="peligro"]:hover {
    background-color: #ed4245;
    color: #ffffff;
}

QPushButton[clase="peligro"]:pressed {
    background-color: #c62a2d;
    border-color: #c62a2d;
}

/* Botones tipo "interruptor" en un grupo exclusivo (ej. el selector de
 * metodo de pago en la pestaña Vender: setCheckable(true) + QButtonGroup
 * exclusivo, marcados desde C++ con setProperty("clase", "seleccionable")).
 * Sin seleccionar se ven neutros; el que queda :checked se pinta con el
 * mismo degradado teal que un boton "primario", para que sea obvio de un
 * vistazo cual esta activo sin tener que leer una casilla o un combo. */
QPushButton[clase="seleccionable"] {
    background-color: #313338;
    border: 1px solid #3f4147;
    color: #949ba4;
}

QPushButton[clase="seleccionable"]:hover {
    background-color: #3a3c42;
    border-color: #4a4d54;
    color: #e3e5e8;
}

QPushButton[clase="seleccionable"]:checked {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #2dd4bf,
        stop: 1 #0d9488
    );
    border-color: #0d9488;
    color: #052e2b;
    font-weight: 700;
}

QPushButton[clase="seleccionable"]:checked:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #5eead4,
        stop: 1 #0f9488
    );
}

/* ---------- Campos de entrada ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox {
    background-color: #313338;
    color: #e3e5e8;
    border: 1px solid #3f4147;
    border-radius: 6px;
    padding: 8px 10px;
    selection-background-color: #14b8a6;
    selection-color: #052e2b;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #14b8a6;
}

/* Campo deshabilitado (ej. "Codigo" al editar un producto): mas oscuro y
 * con texto tenue, para que sea obvio de un vistazo que no se puede tocar.
 * La QPalette (ver TemaOscuro.cpp) ya deja el texto en un gris apagado;
 * aqui reforzamos tambien fondo y borde porque el QSS de arriba
 * (QLineEdit, QSpinBox...) especifica su propio background-color, que si
 * no se pisa explicitamente aqui, GANA por encima de la paleta.
 */
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background-color: #26272b;
    color: #6a6e78;
    border-color: #313338;
}

QLineEdit::placeholder {
    color: #6a6e78;
}

/* OJO: aqui NO se estiliza QSpinBox::up-button/down-button. En QSS, en
 * cuanto una regla toca el subcontrol de un boton de flecha, Qt deja de
 * dibujar el glifo nativo (la flechita) y hay que proveerlo a mano con
 * ::up-arrow/::down-arrow (tipicamente una imagen). Es mas simple dejar
 * que el estilo Fusion las dibuje de forma nativa -- ya se ven bien
 * porque respetan la QPalette oscura que configuramos en
 * TemaOscuro.cpp (rol ButtonText). */

/* ---------- Tablas ---------- */
QTableWidget {
    background-color: #2b2d31;
    alternate-background-color: #313338;
    gridline-color: #3f4147;
    border: 1px solid #3f4147;
    border-radius: 6px;
    /* Teal, no el azul-violeta de los botones -- ver nota de paleta arriba. */
    selection-background-color: #14b8a6;
    selection-color: #052e2b;
}

QTableWidget::item {
    padding: 6px 8px;
    color: #e3e5e8;
}

QTableWidget::item:selected {
    color: #052e2b;
    font-weight: 600;
}

QHeaderView::section {
    background-color: #232428;
    color: #949ba4;
    padding: 8px;
    border: none;
    border-bottom: 1px solid #3f4147;
    font-weight: 600;
}

/* ---------- Splitter (divisor arrastrable en la pestaña Vender) ---------- */
QSplitter::handle {
    background-color: #3f4147;
    width: 2px;
}

/* ---------- Barra de estado ---------- */
QStatusBar {
    background-color: #232428;
    color: #949ba4;
    border-top: 1px solid #3f4147;
}

/* ---------- Cuadros de dialogo estandar (QMessageBox, QInputDialog) ---------- */
QMessageBox, QInputDialog {
    background-color: #2b2d31;
}

/* ---------- Scrollbars (mas delgados y planos que el estilo por defecto) ---------- */
QScrollBar:vertical {
    background: #1e1f22;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #4a4d54;
    min-height: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: #5c5f66;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1e1f22;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #4a4d54;
    min-width: 24px;
    border-radius: 5px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: #5c5f66;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* ---------- QDialogButtonBox ---------- */
QDialogButtonBox {
    background: transparent;
}
